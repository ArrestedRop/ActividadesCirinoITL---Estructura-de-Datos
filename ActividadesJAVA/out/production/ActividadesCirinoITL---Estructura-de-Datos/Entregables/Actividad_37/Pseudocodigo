Variables Globales:
int orden
float distancia

1. METODO goal():
    ESCRIBE "Script que dibuja la curva de Hilbert de manera recursiva (fractal)"
    ESCRIBE "utilizando graficas de tortuga relativas (avanzar y girar)"

2. METODO data(): //Generador datos
    ESCRIBE "Deme el nivel de profundidad (orden) de la curva fractal:"
    CAPTURAR orden
    ESCRIBE "Deme la longitud en pixeles para cada segmento:"
    CAPTURAR distancia
   TERMINAR METODO

3. PROCESOS
3.1 METODO drawHilbert(int nivel, int angulo):
        SI (nivel == 0) REGRESAR;

        gira(angulo)
        drawHilbert(nivel - 1, -angulo)
        avanzar(distancia)
        gira(-angulo)
        drawHilbert(nivel - 1, angulo)
        avanzar(distancia)
        drawHilbert(nivel - 1, angulo)
        gira(-angulo)
        avanzar(distancia)
        drawHilbert(nivel - 1, -angulo)
        gira(angulo)
    TERMINAR METODO

3.2 METODO avanzar(float dist):
        // Lógica para mover el cursor en la direccion actual y pintar la linea
        ESCRIBE "Avanzando " + dist + " unidades"
    TERMINAR METODO

3.3 METODO gira(int angulo):
        // Lógica para rotar la dirección actual del cursor
        ESCRIBE "Girando " + angulo + " grados"
    TERMINAR METODO

4 SALIDA
4.1 METODO canvas():
        ESCRIBE("INICIALIZANDO LIENZO GRAFICO PARA CURVA DE HILBERT")
        ESCRIBE("ORDEN | DISTANCIA")
        ESCRIBE(orden + " | " + distancia)

        // Se llama con el ángulo estándar de 90 grados para empezar
        drawHilbert(orden, 90)
    TERMINAR METODO

5 NAVEGACION
5.1 METODO navigation():
        goal()
        data()
        canvas()
    TERMINAR METODO

METODO main():
    navigation()