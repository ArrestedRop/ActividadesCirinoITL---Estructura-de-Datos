Variables Globales:
int orden
float distancia
double tX
double tY
double anguloActual

1. METODO goal():
    ESCRIBE "Script que recibe el nivel y la longitud de pixeles "
    ESCRIBE "para dibuja la curva de Hilbert gráficamente"
    ESCRIBE "utilizando la forma de graficar que se ajuste a la aplicacion."
   TERMINAR METODO

2. METODO data():
    ESCRIBE "Deme el nivel (orden) de la curva fractal: "
    CAPTURAR orden
    ESCRIBE "Deme la longitud en pixeles (segmento): "
    CAPTURAR distancia
   TERMINAR METODO

3. PROCESOS
3.1 METODO paintComponent(Graphics g):
        tX = 20
        tY = 20
        anguloActual = 0
        drawHilbert(g, orden, 90)
    TERMINAR METODO

3.2 METODO drawHilbert(Graphics g, int nivel, int angulo):
        SI (nivel == 0) REGRESAR;

        gira(angulo)
        drawHilbert(g, nivel - 1, -angulo)
        avanzar(g, distancia)
        gira(-angulo)
        drawHilbert(g, nivel - 1, angulo)
        avanzar(g, distancia)
        drawHilbert(g, nivel - 1, angulo)
        gira(-angulo)
        avanzar(g, distancia)
        drawHilbert(g, nivel - 1, -angulo)
        gira(angulo)
    TERMINAR METODO

3.3 METODO avanzar(Graphics g, float dist):
        rad = CONVERTIR_A_RADIANES(anguloActual)
        nextX = tX + (dist * COSENO(rad))
        nextY = tY + (dist * SENO(rad))

        DIBUJAR_LINEA(tX, tY, nextX, nextY)
        tX = nextX
        tY = nextY
    TERMINAR METODO

3.4 METODO gira(int angulo):
        anguloActual = anguloActual + angulo
    TERMINAR METODO

4 SALIDA
4.1 METODO canvas():
        ESCRIBE "\nINICIALIZANDO LIENZO GRAFICO..."
        CREAR VENTANA "Curva de Hilbert - Tortuga Grafica" (800x800)
        AGREGAR LIENZO A VENTANA
        MOSTRAR VENTANA
    TERMINAR METODO

5 NAVEGACION
5.1 METODO navigation():
        goal()
        data()
        canvas() // Esto eventualmente dispara paintComponent()
    TERMINAR METODO

METODO main():
    navigation()