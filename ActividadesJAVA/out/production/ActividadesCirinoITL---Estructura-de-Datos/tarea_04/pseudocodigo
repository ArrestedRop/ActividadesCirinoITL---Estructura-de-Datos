Variables Globales:
int orden
float distancia
float currentX
float currentY
int currentAngle

1. METODO goal():
    ESCRIBE "Script que dibuja la curva de Koch de manera recursiva (fractal)"
    ESCRIBE "calculando coordenadas reales con senos y cosenos para una ventana grafica"

2. METODO data(): //Generador datos
    ESCRIBE "Deme el nivel de profundidad (orden) de la curva fractal:"
    CAPTURAR orden
    ESCRIBE "Deme la longitud en pixeles para el segmento inicial:"
    CAPTURAR distancia
   TERMINAR METODO

3. PROCESOS
3.1 METODO drawKoch(int nivel, float dist):
        SI (nivel == 0) ENTONCES:
            avanzar(dist)
        SINO:
            float nuevaDist = dist / 3.0

            drawKoch(nivel - 1, nuevaDist)
            gira(60)   // Girar a la izquierda

            drawKoch(nivel - 1, nuevaDist)
            gira(-120) // Girar a la derecha para bajar el pico

            drawKoch(nivel - 1, nuevaDist)
            gira(60)   // Girar a la izquierda para enderezar

            drawKoch(nivel - 1, nuevaDist)
        TERMINAR SI
    TERMINAR METODO

3.2 METODO avanzar(float dist):
        // Convertir grados a radianes para usar funciones trigonometricas
        float radianes = currentAngle * (PI / 180.0)

        // Calcular las nuevas coordenadas X y Y
        float newX = currentX + (dist * COS(radianes))
        float newY = currentY - (dist * SIN(radianes)) // Resta porque el eje Y va hacia abajo

        // Trazar la linea en la interfaz grafica
        DIBUJAR_LINEA(currentX, currentY, newX, newY)

        // Actualizar la posicion de la tortuga
        currentX = newX
        currentY = newY
    TERMINAR METODO

3.3 METODO gira(int angulo):
        // Actualizar el angulo hacia donde apunta el trazador
        currentAngle = currentAngle + angulo
    TERMINAR METODO

4 SALIDA
4.1 METODO canvas():
        ESCRIBE("INICIALIZANDO LIENZO GRAFICO PARA CURVA DE KOCH")

        // Configurar la posicion inicial de la tortuga en la pantalla
        currentX = 100
        currentY = 400
        currentAngle = 0 // Apuntando al este (derecha)

        ABRIR_VENTANA_GRAFICA()

        // Se inicia el trazo recursivo
        drawKoch(orden, distancia)
    TERMINAR METODO

5 NAVEGACION
5.1 METODO navigation():
        goal()
        data()
        canvas()
    TERMINAR METODO

