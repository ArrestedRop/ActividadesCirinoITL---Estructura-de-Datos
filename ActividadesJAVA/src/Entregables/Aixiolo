3.6 METODO radixSort(int Arreglo[]):
        SI (Arreglo[] == null) REGRESAR;
        int n = Arreglo.lenght()

        // 1. Encontrar el número máximo para saber cuántos dígitos tiene
        int maximo = Arreglo[0]
        DESDE i = 1 HASTA (n) EMPEZAR:
            SI (Arreglo[i] > maximo) ENTONCES:
                maximo = Arreglo[i]
            TERMINAR SI
        TERMINAR DESDE

        // 2. Hacer counting sort para cada dígito.
        // exp va multiplicándose por 10 (1, 10, 100...) para moverse de posición
        DESDE exp = 1 HASTA (maximo / exp > 0) PASO exp = exp * 10 EMPEZAR:
            countingSortPorDigito(Arreglo[], n, exp)
        TERMINAR DESDE
    TERMINAR METODO
