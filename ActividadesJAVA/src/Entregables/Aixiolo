3.5 METODO quickSort(int Arreglo[], int bajo, int alto):
        SI (bajo < alto) ENTONCES:
            // pi es el índice de partición
            int pi = particion(Arreglo[], bajo, alto)

            // Ordenamos recursivamente las dos mitades
            quickSort(Arreglo[], bajo, pi - 1)
            quickSort(Arreglo[], pi + 1, alto)
        TERMINAR SI
    TERMINAR METODO

3.5.1 METODO int particion(int Arreglo[], int bajo, int alto):
        int pivote = Arreglo[alto]
        int i = (bajo - 1)
        int temp = 0

        DESDE j = bajo HASTA (alto) EMPEZAR:
            SI (Arreglo[j] < pivote) ENTONCES:
                i = i + 1
                // Intercambio
                temp = Arreglo[i]
                Arreglo[i] = Arreglo[j]
                Arreglo[j] = temp
            TERMINAR SI
        TERMINAR DESDE

        // Intercambio final para acomodar el pivote
        temp = Arreglo[i + 1]
        Arreglo[i + 1] = Arreglo[alto]
        Arreglo[alto] = temp

        REGRESAR (i + 1)
    TERMINAR METODO

