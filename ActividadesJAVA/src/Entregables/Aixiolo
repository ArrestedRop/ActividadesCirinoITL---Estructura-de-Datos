3.6.1 METODO countingSortPorDigito(int Arreglo[], int n, int exp):
        CREAR Int Salida[n]
        CREAR Int Conteo[10] // Base 10 para los dígitos del 0 al 9
        int temp = 0

        // Inicializar conteo en 0
        DESDE i = 0 HASTA (10) EMPEZAR:
            Conteo[i] = 0
        TERMINAR DESDE

        // Almacenar el conteo de las ocurrencias de cada dígito
        DESDE i = 0 HASTA (n) EMPEZAR:
            int digito = (Arreglo[i] / exp) % 10
            Conteo[digito] = Conteo[digito] + 1
        TERMINAR DESDE

        // Cambiar Conteo[i] para que contenga la posición real en Salida[]
        DESDE i = 1 HASTA (10) EMPEZAR:
            Conteo[i] = Conteo[i] + Conteo[i - 1]
        TERMINAR DESDE

        // Construir el arreglo de salida de atrás hacia adelante
        DESDE i = (n - 1) HASTA (i >= 0) PASO i = i - 1 EMPEZAR:
            int digito = (Arreglo[i] / exp) % 10
            Salida[Conteo[digito] - 1] = Arreglo[i]
            Conteo[digito] = Conteo[digito] - 1
        TERMINAR DESDE

        // Copiar el arreglo de salida al Arreglo[] original
        DESDE i = 0 HASTA (n) EMPEZAR:
            Arreglo[i] = Salida[i]
        TERMINAR DESDE
    TERMINAR METODO