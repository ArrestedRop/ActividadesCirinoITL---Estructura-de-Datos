3.4 METODO shellSort(int Arreglo[]):
        SI (Arreglo[] == null) REGRESAR;
        int n = Arreglo.lenght()
        int temp = 0
        int j = 0

        // Arrancamos con una brecha (gap) a la mitad del tamaño
        DESDE brecha = n / 2 HASTA (brecha > 0) PASO brecha = brecha / 2 EMPEZAR:
            DESDE i = brecha HASTA (n) EMPEZAR:
                temp = Arreglo[i]
                j = i
                MIENTRAS (j >= brecha Y Arreglo[j - brecha] > temp) EMPEZAR:
                    Arreglo[j] = Arreglo[j - brecha]
                    j = j - brecha
                TERMINAR MIENTRAS
                Arreglo[j] = temp
            TERMINAR DESDE
        TERMINAR DESDE
    TERMINAR METODO

