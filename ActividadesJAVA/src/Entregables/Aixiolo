3.3 METODO bubbleSort(int Arreglo[]):
        SI (Arreglo[] == null) REGRESAR;
        int n = Arreglo.lenght()
        int temp = 0

        DESDE i = 0 HASTA (n - 1) EMPEZAR:
            DESDE j = 0 HASTA (n - i - 1) EMPEZAR:
                SI (Arreglo[j] > Arreglo[j + 1]) ENTONCES:
                    // Intercambio de elementos (Swap)
                    temp = Arreglo[j]
                    Arreglo[j] = Arreglo[j + 1]
                    Arreglo[j + 1] = temp
                TERMINAR SI
            TERMINAR DESDE
        TERMINAR DESDE
    TERMINAR METODO
