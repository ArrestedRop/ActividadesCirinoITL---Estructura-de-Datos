METODO main()
    // 1. Instanciación de los objetos (Generics de Strings)
    Conjunto<String> conjuntoA = NUEVO Conjunto()
    Conjunto<String> conjuntoB = NUEVO Conjunto()

    // 2. Registro de datos (Prueba de addElt y duplicados)
    conjuntoA.addElt("Manzana")
    conjuntoA.addElt("Pera")
    conjuntoA.addElt("Uva")
    conjuntoA.addElt("Manzana") // Intento de duplicado

    conjuntoB.addElt("Uva")
    conjuntoB.addElt("Mango")
    conjuntoB.addElt("Sandía")

    // Mostrar estado inicial
    IMPRIMIR "Conjunto A: " + (conjuntoA.hasElt() ? "Con datos" : "Vacío")
    IMPRIMIR "Tamaño A: " + conjuntoA.size()
    IMPRIMIR "Tamaño B: " + conjuntoB.size()

    IMPRIMIR "--- PRUEBAS DE OPERACIONES ---"

    // 3. Prueba de Unión (A + B)
    Conjuntable<String> union = conjuntoA.union(conjuntoB)
    IMPRIMIR "Unión (A + B) tamaño: " + union.size()

    // 4. Prueba de Intersección (A ^ B)
    Conjuntable<String> interseccion = conjuntoA.interseccion(conjuntoB)
    IMPRIMIR "¿Intersección contiene 'Uva'?: " + interseccion.contains("Uva")

    // 5. Prueba de Diferencia (A - B)
    Conjuntable<String> diferencia = conjuntoA.diferens(conjuntoB)
    IMPRIMIR "Diferencia (A - B) tamaño: " + diferencia.size()

    // 6. Prueba de Relación (Subconjunto)
    IMPRIMIR "¿A es subconjunto de Unión?: " + conjuntoA.subSet(union)

    // 7. Prueba de Limpieza
    conjuntoA.remElt("Pera")
    IMPRIMIR "Tamaño A tras borrar 'Pera': " + conjuntoA.size()

    conjuntoA.toEmpty()
    IMPRIMIR "¿A está vacío tras toEmpty()?: " + !conjuntoA.hasElt()
FIN METODO


