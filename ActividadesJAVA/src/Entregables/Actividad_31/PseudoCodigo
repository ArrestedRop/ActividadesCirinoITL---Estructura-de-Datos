ENTERO LARGO ms, ps, prs, mb, pb, prb
ARREGLO DE ENTEROS arreglo
CADENA num

// 1. META
MODULO goal()
    IMPRIMIR "Script basico que permite medir el tiempo"
    IMPRIMIR "en los escenarios mejor, peor y promedio de los "
    IMPRIMIR "algoritmos de busqueda secuencial y binaria"
    IMPRIMIR "ademas de imprimirlo en forma de tabla comparativa"
FIN MODULO

// 2. DATOS
MODULO data()
    IMPRIMIR "Deme la cantidad de terminos que desea generar: "
    LEER num
    MIENTRAS (num NO SEA un numero entero valido O CONVERTIR_A_ENTERO(num) <= 0) HACER
        IMPRIMIR "Dato erroneo, proporcione el dato de nuevo: "
        LEER num
    FIN MIENTRAS
    arreglo = CREAR ARREGLO DE TAMAÑO CONVERTIR_A_ENTERO(num)
FIN MODULO

MODULO generador()
    PARA i DESDE 0 HASTA TAMAÑO(arreglo) - 1 HACER
        arreglo[i] = i
    FIN PARA
FIN MODULO

// 3. PROCESOS
MODULO searchSecuencial(ARREGLO arr, ENTERO busq) RETORNA ENTERO
    PARA i DESDE 0 HASTA TAMAÑO(arr) - 1 HACER
        SI (arr[i] == busq) ENTONCES
            RETORNAR i
        FIN SI
    FIN PARA
    RETORNAR -1
FIN MODULO

MODULO searchBinaria(ARREGLO arr, ENTERO busq) RETORNA ENTERO
    ENTERO inicio = 0
    ENTERO fin = TAMAÑO(arr) - 1
    ENTERO mitad

    MIENTRAS (inicio <= fin) HACER
        mitad = inicio + (fin - inicio) / 2
        SI (arr[mitad] == busq) ENTONCES
            RETORNAR mitad
        FIN SI

        SI (arr[mitad] < busq) ENTONCES
            inicio = mitad + 1
        SINO
            fin = mitad - 1
        FIN SI
    FIN MIENTRAS
    RETORNAR -1
FIN MODULO

// 4. SALIDA
MODULO formatoTiempo(ENTERO LARGO milisegundos) RETORNA CADENA
    // Operaciones matemáticas para obtener horas, minutos, segundos y milisegundos
    RETORNAR cadena_formateada_en_reloj
FIN MODULO

MODULO medirTiempoSecuencial(ARREGLO arr, ENTERO val) RETORNA ENTERO LARGO
    ENTERO LARGO inicio = OBTENER_TIEMPO_ACTUAL()
    PARA i DESDE 0 HASTA 9999 HACER
        LLAMAR searchSecuencial(arr, val)
    FIN PARA
    ENTERO LARGO fin = OBTENER_TIEMPO_ACTUAL()
    RETORNAR (fin - inicio)
FIN MODULO

MODULO medirTiempoBinaria(ARREGLO arr, ENTERO val) RETORNA ENTERO LARGO
    ENTERO LARGO inicio = OBTENER_TIEMPO_ACTUAL()
    PARA i DESDE 0 HASTA 9999 HACER
        LLAMAR searchBinaria(arr, val)
    FIN PARA
    ENTERO LARGO fin = OBTENER_TIEMPO_ACTUAL()
    RETORNAR (fin - inicio)
FIN MODULO

MODULO imprimirTabla()
    IMPRIMIR "--- TABLA COMPARATIVA DE TIEMPOS ---"
    IMPRIMIR "Escenario       | Secuencial      | Binaria"
    IMPRIMIR "---------------------------------------------------"
    IMPRIMIR "Mejor Caso      | " + formatoTiempo(ms)  + " | " + formatoTiempo(mb)
    IMPRIMIR "Promedio        | " + formatoTiempo(ps)  + " | " + formatoTiempo(pb)
    IMPRIMIR "Peor Caso       | " + formatoTiempo(prs) + " | " + formatoTiempo(prb)
    IMPRIMIR "Cantidad de datos procesados: " + (10000 * CONVERTIR_A_ENTERO(num))
FIN MODULO

// 5. NAVEGACION (MAIN)
MODULO PRINCIPAL run()
    ENTERO n
    ENTERO mejorCaso, casoPromedio, peorCaso

    LLAMAR goal()
    LLAMAR data()
    LLAMAR generador()

    n = TAMAÑO(arreglo)
    mejorCaso = arreglo[0]
    casoPromedio = arreglo[n / 2]
    peorCaso = arreglo[n - 1]

    IMPRIMIR "Encendiendo la JVM..."
    LLAMAR medirTiempoSecuencial(arreglo, casoPromedio)
    LLAMAR medirTiempoBinaria(arreglo, casoPromedio)

    ms = LLAMAR medirTiempoSecuencial(arreglo, mejorCaso)
    ps = LLAMAR medirTiempoSecuencial(arreglo, casoPromedio)
    prs = LLAMAR medirTiempoSecuencial(arreglo, peorCaso)

    mb = LLAMAR medirTiempoBinaria(arreglo, casoPromedio)
    pb = LLAMAR medirTiempoBinaria(arreglo, arreglo[n / 4])
    prb = LLAMAR medirTiempoBinaria(arreglo, peorCaso)

    LLAMAR imprimirTabla()
FIN MODULO PRINCIPAL