1.   META
1.1 METODO goal():
    ESCRIBIR("Codigo que busca poner a prueba cada una de las prestaciones")
    ESCRIBIR("que comparte la clase encapsulada Registro paneles")

2.   DATOS
2.1 METODO RegistroPaneles data():
        eficiencia = chequeador(eficiencia)
        superficie = chequeador(superficie)
        costoWatts = chequeador(costoWatts)
        tipoCelda = PIDE("Proporcione el ipo de celda")
        REGRESA RegistroPaneles(eficiencia, superficie, costoWatts, tipoCelda)
    TERMINAR METODO

2.2 METODO double chequeador(double dato):
        ESCRIBIR("Proporcione " + dato)
        HACER:
            dato = PIDE("Proporcione " + dato)
        MIENTRAS (Misc.booleanChecker(dato)) TERMINAR
        REGRESAR dato
    TERMINAR METODO

3.   PROCESOS
3.1 METODO processes(int selection, RegistroPaneles panel):
        SEGUN (selection) ENTONCES:
            CASO 1: P = panel.calcularPotencia()
            CASO 2: CT = panel.calcularCostoTotal()
        TERMINAR
     TERMINAR METODO

