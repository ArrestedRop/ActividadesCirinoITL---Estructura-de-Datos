METODO mezclaDirecta(File f):
    File f1 = "ArchivoAux1"
    File f2 = "ArchivoAux2"
    numReg = TamañoArchivo(f) / 4  // Cada int ocupa 4 bytes
    longSec = 1

    // Se repite mientras el tamaño de la secuencia sea menor al total de registros
    MIENTRAS (longSec < numReg) EMPEZAR
        distribute(f, f1, f2, longSec, numReg)
        mix(f1, f2, f, longSec, numReg)
        longSec = longSec * 2
    TERMINAR
FIN METODO

METODO distribute(f, f1, f2, longSec, numReg):
    flujo  = ABRIR f  PARA LECTURA BINARIA (CON BUFFER)
    flujo1 = ABRIR f1 PARA ESCRITURA BINARIA (CON BUFFER)
    flujo2 = ABRIR f2 PARA ESCRITURA BINARIA (CON BUFFER)

    numSec = numReg / (2 * longSec)
    resto = numReg % (2 * longSec)

    // Distribuir parejas de secuencias completas
    PARA i = 1 HASTA numSec EMPEZAR
        subSecuencia(flujo, flujo1, longSec)
        subSecuencia(flujo, flujo2, longSec)
    TERMINAR

    // Manejo del residuo (lo que no completa una pareja de secuencias)
    SI (resto > longSec) ENTONCES
        resto = resto - longSec
    SINO
        longSec = resto
        resto = 0
    TERMINAR

    subSecuencia(flujo, flujo1, longSec)
    subSecuencia(flujo, flujo2, resto)

    CERRAR flujo, flujo1, flujo2
FIN METODO

METODO mix(f1, f2, f, lonSec, numReg):
    flujo  = ABRIR f  PARA ESCRITURA BINARIA (CON BUFFER)
    flujo1 = ABRIR f1 PARA LECTURA BINARIA (CON BUFFER)
    flujo2 = ABRIR f2 PARA LECTURA BINARIA (CON BUFFER)

    numSec = numReg / (2 * lonSec)
    resto = numReg % (2 * lonSec)

    // Lectura inicial de las cabeceras de cada auxiliar
    c1 = flujo1.readInt()
    c2 = flujo2.readInt()

    PARA s = 1 HASTA (numSec + 1) EMPEZAR
        n1 = lonSec
        n2 = lonSec

        // Ajuste para la última secuencia (el residuo)
        SI (s == numSec + 1) ENTONCES
            SI (resto > lonSec) ENTONCES
                n2 = resto - lonSec
            SINO
                n1 = resto
                n2 = 0
            TERMINAR
        TERMINAR

        i = 1, j = 1
        // Mezclar elementos de los dos tramos
        MIENTRAS (i <= n1 Y j <= n2) EMPEZAR
            SI (c1 < c2) ENTONCES
                flujo.writeInt(c1)
                TRATAR c1 = flujo1.readInt() CAPTURAR(EOF)
                i = i + 1
            SINO
                flujo.writeInt(c2)
                TRATAR c2 = flujo2.readInt() CAPTURAR(EOF)
                j = j + 1
            TERMINAR
        TERMINAR

        // Vaciar elementos restantes de la secuencia en f1
        PARA k = i HASTA n1 EMPEZAR
            flujo.writeInt(c1)
            TRATAR c1 = flujo1.readInt() CAPTURAR(EOF)
        TERMINAR

        // Vaciar elementos restantes de la secuencia en f2
        PARA k = j HASTA n2 EMPEZAR
            flujo.writeInt(c2)
            TRATAR c2 = flujo2.readInt() CAPTURAR(EOF)
        TERMINAR
    TERMINAR

    CERRAR flujo, flujo1, flujo2
FIN METODO

METODO subSecuencia(f, t, longSec):
    PARA j = 1 HASTA longSec EMPEZAR
        clave = f.readInt()
        t.writeInt(clave)
    TERMINAR
FIN METODO